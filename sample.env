# ============================================================
# qb-slow-queue 环境变量配置（拷贝为 .env 后按实际修改）
# 版本唯一来源：qbslowqueue/__init__.py（本文件不含版本号）
# ============================================================

# ---------- 时区配置 ----------
# 容器时区，决定日志时间是否与本地一致。默认 Asia/Shanghai（UTC+8）。
# 修改后需 docker compose up -d --force-recreate 重建容器才生效。
TZ=Asia/Shanghai

# ---------- qBittorrent 连接配置 ----------
# qBittorrent 的 IP 地址（与容器互通；同网络可直接用内网 IP）
QB_HOST=192.168.1.100
# qBittorrent WebUI 端口
QB_PORT=8080
# WebUI API Key（qBittorrent ≥5.2.0，必填）
# 生成位置：WebUI → 选项 → WebUI → 认证 → API Key
# 格式：qbt_ 开头，共 32 字符。本程序仅用 API Key 认证，不再使用用户名/密码。
QB_API_KEY=your_qb_webui_api_key_here

# ---------- 运行参数 ----------
# 速度阈值（字节/秒）：任务当前下载速度低于该值即被判定为"慢速"并在本次扫描移至末尾
# 51200 = 50 KB/s；设为 0 表示仅移动完全无速度（0 字节/秒）的任务
SPEED_THRESHOLD=51200
# 检查间隔（秒）：每隔多久扫描一次任务；每次扫描都会对当前低于阈值的任务执行移动。
# 已合并原 SLOW_DURATION（不再做"持续观察窗口"判定，即时移动）。
# 300 = 5 分钟。间隔越短检测越灵敏，但也越频繁请求 qBittorrent。
CHECK_INTERVAL=300
# 日志级别：DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO
